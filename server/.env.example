PORT=5000
NODE_ENV=development

# Required for development, tests, and production. Tests use this same database.
# Get the URI from Atlas > Connect > Drivers. Keep credentials private.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/newtonite?retryWrites=true&w=majority

# Optional: Google Gemini API key for live AI triage. If omitted, intelligent heuristic engine is used.
# GEMINI_API_KEY=your_gemini_api_key_here
